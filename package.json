    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "imapflow": "^2.2.1",
    "mailparser": "^3.9.33",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  }
}
