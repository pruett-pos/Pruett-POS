# Copy to .env for local use. On Railway, set these under Variables.
DATABASE_URL=postgres://pruett:pruett@localhost:5432/pruett_pos
# Railway Postgres requires SSL from outside its private network; set true if you see SSL errors.
DATABASE_SSL=false
NODE_ENV=production
PORT=3000

# First start only: creates the admin login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password
ADMIN_NAME=AL Kharitonov

# Stripe Terminal. Leave blank to use the built-in card simulator (training mode).
# Use sk_test_... first, then switch to sk_live_... when the readers are set up.
STRIPE_SECRET_KEY=

# ---------- AI price agent ----------
# Claude reads vendor price sheets (PDF, Excel, CSV, photos, email text). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Inbox the agent watches for vendor emails (Gmail: turn on 2-Step Verification, then create an App Password).
PRICE_INBOX_USER=pruetthomesupply@gmail.com
PRICE_INBOX_APP_PASSWORD=
PRICE_INBOX_POLL_MINUTES=15
# Who gets "price changes need approval" emails (comma separated)
PRICE_NOTIFY_EMAILS=al@aaqualityroofing.com
# Public address of the POS, used for links in those emails
APP_URL=https://pos.example.com
